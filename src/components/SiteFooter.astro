---
const clubUrl = 'https://vibecodingclub.kr/';
---

<footer class="site-footer">
	<p class="site-footer__credit">
		Vibe Fold는{' '}
		<a class="site-footer__link" href={clubUrl} rel="noreferrer">바이브코딩클럽</a>의
		아카이브입니다
	</p>
</footer>

<style>
	.site-footer {
		padding: var(--space-archive-y) var(--page-pad);
	}

	.site-footer__credit {
		font-size: var(--text-meta);
		font-weight: 400;
		line-height: var(--lh-tight);
		color: var(--color-muted);
	}

	.site-footer__link {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.site-footer__link:hover {
		color: var(--color-text);
	}
</style>
