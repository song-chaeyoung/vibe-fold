---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	bodyClass?: string;
	/** Root-relative share card. Chapters may ship their own; everything else
	 *  falls back to the site card. */
	image?: string;
	/** Root-relative favicon override, for chapters that ship one. */
	icon?: string;
	type?: 'website' | 'article';
	themeColor?: string;
}

const {
	title,
	description = 'We publish visual stories that move the world',
	bodyClass = '',
	image = '/og.jpg',
	icon,
	type = 'website',
	themeColor = '#ffffff',
} = Astro.props;

// Summaries are authored as paragraphs; meta tags want one flat line.
const summary = description.replace(/\s+/g, ' ').trim().slice(0, 200);

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={summary} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content={themeColor} />

		{
			icon ? (
				<link rel="icon" href={icon} />
			) : (
				<>
					<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
					<link rel="icon" href="/favicon.ico" />
				</>
			)
		}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Vibe Fold" />
		<meta property="og:locale" content="ko_KR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={summary} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={summary} />
		<meta name="twitter:image" content={shareImage} />
	</head>
	<body class={bodyClass}>
		<slot />
	</body>
</html>
